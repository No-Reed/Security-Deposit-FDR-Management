NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/depositdesk
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/depositdesk_test
SESSION_SECRET=replace-with-a-long-random-secret-at-least-64-chars
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000/api/v1
UPLOAD_DIR=./private-uploads
MAX_UPLOAD_MB=10
APP_TIMEZONE=Asia/Kolkata
DEMO_MODE=true
MATURITY_ALERT_DAYS=90,60,30,15,7,1
ESCALATION_DAYS=7
ESCALATION_REPEAT_DAYS=3
